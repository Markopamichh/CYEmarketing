---
import { clients } from '../data/clients';
// Duplicamos la lista para el loop infinito del marquee
const loop = [...clients, ...clients];
---

<section class="border-y border-ink/10 py-10 md:py-14" aria-label="Clientes">
  <p class="mb-8 text-center text-sm uppercase tracking-[0.18em] text-ink/50">
    Marcas de Centenario y Neuquén que ya confían en nosotros
  </p>

  <div class="marquee overflow-hidden" id="logo-marquee">
    <div class="marquee-track flex w-max items-center gap-14 px-7 md:gap-20">
      {
        loop.map((client) => (
          <span class="shrink-0">
            {client.logo ? (
              <img
                src={client.logo}
                alt={client.name}
                class="h-8 opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0 md:h-10"
                loading="lazy"
              />
            ) : (
              /* Wordmark placeholder — se reemplaza solo agregando `logo` en clients.ts */
              <span class="whitespace-nowrap font-serif text-2xl text-ink/40 transition hover:text-accent md:text-3xl">
                {client.name}
              </span>
            )}
          </span>
        ))
      }
    </div>
  </div>
</section>

