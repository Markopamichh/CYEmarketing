---
import { WHATSAPP_URL } from '../data/site';
---

<section class="relative overflow-hidden px-6 pt-28 pb-20 md:pt-40 md:pb-32">
  <div class="mx-auto max-w-5xl">
    <p
      class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/60"
      data-hero-fade
      style="animation-delay:.1s"
    >
      Estudio de marketing · Centenario, Neuquén
    </p>

    <h1
      class="font-serif text-[2.6rem] leading-[1.08] md:text-7xl"
      id="hero-title"
    >
      <span class="block overflow-hidden"
        ><span class="hero-line-inner block">Hacemos que a tu negocio</span></span
      >
      <span class="block overflow-hidden"
        ><span class="hero-line-inner block"
          >lo <em class="text-accent">encuentren</em>, lo <em class="text-accent">elijan</em></span
        ></span
      >
      <span class="block overflow-hidden"
        ><span class="hero-line-inner block">y lo <em class="text-accent">recuerden</em>.</span></span
      >
    </h1>

    <p class="mt-8 max-w-xl text-lg text-ink/70" data-hero-fade style="animation-delay:.5s">
      Somos dos personas, no una agencia anónima. Trabajamos con negocios reales
      de Centenario, Neuquén y el Alto Valle: redes, contenido, publicidad y
      marca, con resultados que se ven.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-5" data-hero-fade style="animation-delay:.62s">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="btn rounded-subtle bg-ink px-7 py-3.5 text-cream hover:bg-accent"
      >
        Escribinos por WhatsApp
      </a>
      <a href="#casos" class="link-underline text-ink/80">Ver casos de éxito ↓</a>
    </div>
  </div>

  <!-- Asterisco decorativo que rota con el scroll -->
  <svg
    id="hero-asterisk"
    class="pointer-events-none absolute -right-8 top-16 h-32 w-32 text-accent/70 md:right-16 md:top-24 md:h-48 md:w-48"
    viewBox="0 0 100 100"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M50 8v84M14 29l72 42M14 71l72-42"
      stroke="currentColor"
      stroke-width="6"
      stroke-linecap="round"
    />
  </svg>
</section>

<style>
  /* Animación de entrada del hero en CSS puro: no depende de JS, así el título
     (elemento LCP) pinta y anima al instante sin esperar a GSAP. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-line-inner {
      transform: translateY(110%);
      animation: heroLine 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    #hero-title > span:nth-child(1) .hero-line-inner { animation-delay: 0.05s; }
    #hero-title > span:nth-child(2) .hero-line-inner { animation-delay: 0.13s; }
    #hero-title > span:nth-child(3) .hero-line-inner { animation-delay: 0.21s; }

    [data-hero-fade] {
      opacity: 0;
      transform: translateY(24px);
      animation: heroFade 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes heroLine {
    to { transform: translateY(0); }
  }
  @keyframes heroFade {
    to { opacity: 1; transform: none; }
  }
</style>
