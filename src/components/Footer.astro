---
import {
  SITE,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  WHATSAPP_URL,
  CONTACT_EMAIL,
} from '../data/site';
const year = new Date().getFullYear();

const PORTFOLIO_URL = 'https://markopamich.com/';

const sections = [
  {
    label: 'Secciones',
    links: [
      { title: 'Nosotros', href: '#nosotras' },
      { title: 'Servicios', href: '#servicios' },
      { title: 'Casos de éxito', href: '#casos' },
      { title: 'Proceso', href: '#proceso' },
    ],
  },
  {
    label: 'Contacto',
    links: [
      { title: 'WhatsApp', href: WHATSAPP_URL, external: true },
      { title: INSTAGRAM_HANDLE, href: INSTAGRAM_URL, external: true },
      
    ],
  },
  {
    label: 'Zona de trabajo',
    links: [
      { title: 'Centenario', href: '#' },
      { title: 'Neuquén capital', href: '#' },
      { title: 'Plottier', href: '#' },
      { title: 'Cipolletti y Alto Valle', href: '#' },
    ],
  },
];
---

<footer class="relative border-t border-ink/10 px-6 py-16">
  <!-- Detalle de luz superior centrado -->
  <div
    class="absolute left-1/2 top-0 h-px w-1/3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/40 blur-sm"
    aria-hidden="true"
  ></div>

  <div class="mx-auto grid max-w-5xl gap-10 xl:grid-cols-3" data-reveal-group>
    <div class="space-y-4" data-reveal>
      <p class="font-serif text-2xl">{SITE.name}</p>
      <p class="max-w-xs text-sm text-ink/60">
        Estudio de marketing digital en Centenario, Neuquén. Acompañamos a
        negocios y emprendimientos del Alto Valle a crecer en redes con
        estrategia, contenido y publicidad.
      </p>
      <div class="flex items-center gap-4 pt-2">
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
          class="text-ink/50 transition-colors hover:text-accent"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener"
          aria-label="WhatsApp"
          class="text-ink/50 transition-colors hover:text-accent"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" />
            <path d="M8.8 9.2c0 3.3 2.7 6 6 6l1.4-1.4-1.9-1.2-1 .7a4.6 4.6 0 0 1-2.6-2.6l.7-1-1.2-1.9L8.8 9.2Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 xl:col-span-2" data-reveal>
      {
        sections.map((section) => (
          <div>
            <h3 class="text-xs uppercase tracking-[0.18em] text-ink/50">{section.label}</h3>
            <ul class="mt-4 space-y-2 text-sm text-ink/60">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="link-underline inline-flex items-center transition-colors hover:text-ink"
                    {...('external' in link && link.external
                      ? { target: '_blank', rel: 'noopener' }
                      : {})}
                  >
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="mx-auto mt-14 flex max-w-5xl flex-col gap-3 border-t border-ink/10 pt-6 text-xs text-ink/40 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name} — Marketing digital en Centenario y Neuquén, Argentina.</p>
    <p>
      Designed &amp; developed by
      <a
        href="https://markopamich.com/"
        target="_blank"
        rel="noopener"
        class="link-underline text-ink/60 hover:text-accent"
      >
        Marko Pamich
      </a>
    </p>
  </div>
</footer>
